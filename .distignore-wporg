# CUSTOM_TOOLS_CLI. Runtime is also gated off via
# SD_AI_AGENT_FEATURE_WP_CLI_DISPATCHER = false (forced in the bundled
# main plugin file by bin/build.sh below).
includes/Abilities/WpCliAbilities.php

